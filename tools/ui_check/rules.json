{
  "forbidden_class_patterns": [
    "text-dark",
    "bg-light",
    "text-bg-[a-z0-9-]+",
    "table-light",
    "bg-(?:secondary|info|warning|success|danger|primary|dark)",
    "badge",
    "link-body-emphasis",
    "btn-(?:success|warning|info|secondary|light|dark)",
    "btn-outline-(?:success|warning|info|light|dark)",
    "btn-close-white",
    "border",
    "border-(?:top|bottom|start|end)",
    "border-(?:primary|secondary|success|info|warning|danger|light|dark)",
    "bg-body-(?:secondary|tertiary)",
    "text-body-emphasis",
    "text-white",
    "text-black",
    "bg-white",
    "display-[1-6]",
    "lead",
    "fw-light",
    "fw-lighter"
  ],
  "forbidden_variable_patterns": [
    "--bs-tertiary-bg(?![\\w-])",
    "--bs-secondary-bg(?![\\w-])",
    "--bs-border-color(?![\\w-])",
    "--bs-[a-z]+-bg-subtle",
    "--bs-[a-z]+-border-subtle",
    "--bs-emphasis-color",
    "--bs-light(?![\\w-])",
    "--bs-light-rgb",
    "--bs-dark(?![\\w-])",
    "--bs-dark-rgb",
    "--bs-gray-[\\w-]+",
    "--bs-white(?![\\w-])",
    "--bs-white-rgb",
    "--bs-black(?![\\w-])",
    "--bs-black-rgb",
    "--bs-highlight-bg",
    "--bs-secondary-color",
    "--bs-tertiary-color"
  ]
}
