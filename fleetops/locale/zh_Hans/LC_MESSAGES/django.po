msgid "withdrawn"
msgstr "已撤回"

#: texts.py
msgid "Classified from a fleet's composition"
msgstr "根据舰队编成归类"

#: texts.py
msgid "Roles synced from Discord in FleetOps front-end administration"
msgstr "在 FleetOps 后台设置中从 Discord 同步了身份组"

#: texts.py
msgid "Edited from FleetOps fleet archive"
msgstr "在 FleetOps 舰队档案中编辑"

#: texts.py
#, python-format
msgid "Fleet times edited. %(detail)s"
msgstr "舰队时间已修改。%(detail)s"

#: texts.py
msgid "manual PAP deleted"
msgstr "已删除补录 PAP"

#: texts.py
msgid "manual recalculation"
msgstr "手动重新计算"

#: texts.py
msgid "Updated from FleetOps front-end administration"
msgstr "在 FleetOps 后台设置中更新"

#: texts.py
msgid "Changed from FleetOps front-end administration"
msgstr "在 FleetOps 后台设置中修改"

#: texts.py
msgid "Deleted from FleetOps front-end administration"
msgstr "在 FleetOps 后台设置中删除"

#: texts.py
msgid "Default template replaced from FleetOps front-end administration"
msgstr "在 FleetOps 后台设置中更换了默认模板"

#: texts.py
msgid "Default ship function replaced from FleetOps front-end administration"
msgstr "在 FleetOps 后台设置中更换了默认舰船功能"

#: texts.py
msgid "Default payout rule replaced from FleetOps front-end administration"
msgstr "在 FleetOps 后台设置中更换了默认赔付规则"

#: texts.py
msgid "That ship function no longer exists or is disabled."
msgstr "该舰船功能已不存在或已被停用。"

#: texts.py
msgid "That ship type does not exist."
msgstr "该船型不存在。"

#: texts.py
#, python-format
msgid "%(ship)s already counts as %(function)s."
msgstr "%(ship)s 已经归入 %(function)s。"

#: texts.py
#, python-format
msgid "%(ship)s now counts as %(function)s."
msgstr "%(ship)s 现在归入 %(function)s。"

#: texts.py
#, python-format
msgid "Rejected automatically: the %(limit)s is used up (cap %(cap)s)."
msgstr "已自动拒绝：%(limit)s已用完（上限 %(cap)s）。"

#: texts.py
msgid "Imported from fleet roster paste"
msgstr "由粘贴的舰队名单导入"

#: texts.py
msgid "Loss value from zKillboard"
msgstr "损失价值来自 zKillboard"

#: texts.py
msgid "Recalculated with the current policy"
msgstr "已按当前规则重新计算"

#: texts.py
msgid "Reduced to the remaining monthly personal limit."
msgstr "已削减到个人月度限额的剩余额度。"

#: texts.py
msgid "Reduced to the remaining monthly corporation limit."
msgstr "已削减到军团月度限额的剩余额度。"

#: texts.py
msgid "Reduced to the remaining monthly limit."
msgstr "已削减到月度限额的剩余额度。"

#: texts.py
msgid "This check has expired. Check the loss again."
msgstr "这次核对已过期。请重新核对这笔损失。"

#: texts.py
msgid "You checked many losses in a short time. Wait a few minutes and try again."
msgstr "你在短时间内核对了太多笔损失。请等几分钟再试。"

#: texts.py
msgid "You already submitted this loss."
msgstr "你已经提交过这笔损失。"

#: texts.py
msgid "This loss was already claimed by another pilot."
msgstr "这笔损失已被另一位飞行员申请过。"

#: texts.py
#, python-format
msgid "This loss was already claimed by %(name)s."
msgstr "这笔损失已被 %(name)s 申请过。"

#: texts.py
#, python-format
msgid "This claim is already %(status)s."
msgstr "这条申请的状态已经是“%(status)s”。"

#: texts.py
msgid "This claim no longer exists."
msgstr "这条申请已不存在。"

#: texts.py
msgid "Give a reason."
msgstr "请填写原因。"

#: texts.py
msgid "Give a reason for revoking the approval."
msgstr "请填写撤销通过的原因。"

#: texts.py
msgid "Give a reason for undoing the payment."
msgstr "请填写撤销付款的原因。"

#: texts.py
msgid "Give a reason for reopening the claim."
msgstr "请填写重新打开申请的原因。"

#: texts.py
#, python-format
msgid "The reason is too long (at most %(max)s characters)."
msgstr "原因太长（最多 %(max)s 个字符）。"

#: texts.py
#, python-format
msgid "The reason for the rejection is too long (at most %(max)s characters)."
msgstr "拒绝原因太长（最多 %(max)s 个字符）。"

#: texts.py
#, python-format
msgid "The reason for revoking the approval is too long (at most %(max)s characters)."
msgstr "撤销通过的原因太长（最多 %(max)s 个字符）。"

#: texts.py
#, python-format
msgid "The reason for undoing the payment is too long (at most %(max)s characters)."
msgstr "撤销付款的原因太长（最多 %(max)s 个字符）。"

#: texts.py
#, python-format
msgid "The reason for reopening the claim is too long (at most %(max)s characters)."
msgstr "重新打开申请的原因太长（最多 %(max)s 个字符）。"

#: texts.py
#, python-format
msgid "The comment is too long (at most %(max)s characters)."
msgstr "说明太长（最多 %(max)s 个字符）。"

#: texts.py
#, python-format
msgid "The note is too long (at most %(max)s characters)."
msgstr "备注太长（最多 %(max)s 个字符）。"

#: texts.py
msgid "Write the note."
msgstr "请填写备注。"

#: texts.py
msgid "Only the claimant can withdraw this claim."
msgstr "只有申请人才能撤回这条申请。"

#: texts.py
msgid "Only the claimant can submit this claim again."
msgstr "只有申请人才能重新提交这条申请。"

#: texts.py
msgid "Only pending claims can be withdrawn."
msgstr "只能撤回待审核的申请。"

#: texts.py
msgid "Only withdrawn claims can be submitted again."
msgstr "只能重新提交已撤回的申请。"

#: texts.py
msgid "Only pending claims can be recalculated."
msgstr "只能重新计算待审核的申请。"

#: texts.py
msgid "Only pending claims can be approved."
msgstr "只能通过待审核的申请。"

#: texts.py
msgid "Only pending claims can be rejected."
msgstr "只能拒绝待审核的申请。"

#: texts.py
msgid "Only approved claims can be revoked."
msgstr "只能撤销已通过的申请。"

#: texts.py
msgid "Only approved claims can be marked paid."
msgstr "只能把已通过的申请标记为已付款。"

#: texts.py
msgid "Only paid claims can be marked unpaid."
msgstr "只能把已付款的申请标记为未付款。"

#: texts.py
msgid "Only rejected claims can be reopened."
msgstr "只能重新打开已拒绝的申请。"

#: texts.py
msgid "Only pending claims can be moved between in fleet and out of fleet."
msgstr "只有待审核的申请才能在舰队内和舰队外之间移动。"

#: texts.py
msgid "You are not allowed to decide on SRP claims."
msgstr "你无权处理 SRP 申请。"

#: texts.py
msgid "Another SRP manager has to decide on your own claim."
msgstr "你自己的申请必须由另一位 SRP 管理员处理。"

#: texts.py
msgid "Your own claims are decided by another SRP manager."
msgstr "你自己的申请由另一位 SRP 管理员处理。"

#: texts.py
#, python-format
msgid "Enter an amount between 1 and %(max)s ISK."
msgstr "请输入 1 到 %(max)s ISK 之间的金额。"

#: texts.py
#, python-format
msgid "This claim is %(now)s now; it was %(was)s on your page. Check it and decide again."
msgstr "这条申请现在是“%(now)s”状态；你的页面上显示的是“%(was)s”。请核对后重新处理。"

#: texts.py
#, python-format
msgid "The suggested amount changed from %(shown)s to %(current)s while you were looking at the claim. Check it and approve again."
msgstr "你查看申请期间，建议金额从 %(shown)s 变成了 %(current)s。请核对后重新通过。"

#: texts.py
#, python-format
msgid "The amount within the limits changed from %(shown)s to %(current)s while you were looking at the claim. Check it and approve again."
msgstr "你查看申请期间，限额内金额从 %(shown)s 变成了 %(current)s。请核对后重新通过。"

#: texts.py
#, python-format
msgid "The approved amount changed from %(expected)s to %(current)s after your page was loaded. Check it before paying, so the books show what was sent."
msgstr "页面加载之后，已通过的金额从 %(expected)s 变成了 %(current)s。请核对后再付款，这样账目才与实际转出的一致。"

#: texts.py
msgid "This claim is paid. Undo the payment before changing it."
msgstr "这条申请已付款。修改之前请先撤销付款。"

#: texts.py
msgid "This claim is paid. Undo the payment first, then revoke the approval."
msgstr "这条申请已付款。请先撤销付款，再撤销通过。"

#: texts.py
#, python-format
msgid "This claim is already approved for %(amount)s."
msgstr "这条申请已经按 %(amount)s 通过。"

#: texts.py
#, python-format
msgid "%(amount)s is more than the policy amount of %(policy)s. Confirm to pay more than the policy amount."
msgstr "%(amount)s 高于政策金额 %(policy)s。请确认要支付高于政策的金额。"

#: texts.py
#, python-format
msgid "Only %(remaining)s left in the %(limit)s."
msgstr "%(limit)s只剩 %(remaining)s。"

#: texts.py
#, python-format
msgid "This is %(over)s over the %(limit)s (%(remaining)s left). Confirm to approve it anyway."
msgstr "这比%(limit)s多出 %(over)s（剩余 %(remaining)s）。请确认仍要通过。"

#: texts.py
msgid "Give a reason for this amount."
msgstr "请填写这个金额的原因。"

#: texts.py
msgid "This claim has warnings. Review it on its own."
msgstr "这条申请有警告。请单独审核。"

#: texts.py
msgid "This claim has no suggested amount."
msgstr "这条申请没有建议金额。"

#: texts.py
msgid "Choose in fleet or out of fleet."
msgstr "请选择舰队内或舰队外。"

#: texts.py
msgid "Choose the fleet of the loss."
msgstr "请选择这笔损失所属的舰队。"

#: texts.py
msgid "The claim is already a loss of this fleet."
msgstr "这条申请已经是这支舰队的损失。"

#: texts.py
msgid "The claim is already an out-of-fleet loss."
msgstr "这条申请已经是舰队外损失。"

#: texts.py
msgid "The fleet of this claim no longer exists."
msgstr "这条申请所属的舰队已不存在。"

#: texts.py
msgid "Paste an in-game killmail link, a zKillboard link, or the killmail ID and hash."
msgstr "请粘贴游戏内 KM 链接、zKillboard 链接，或 KM ID 与哈希。"

#: texts.py
msgid "Paste the in-game killmail link instead."
msgstr "请改为粘贴游戏内 KM 链接。"

#: texts.py
msgid "Killboard links are not accepted at the moment."
msgstr "目前不接受 Killboard 链接。"

#: texts.py
msgid "This killmail ID is not valid."
msgstr "这个 KM ID 无效。"

#: texts.py
msgid "That text is too long. Paste only the killmail link."
msgstr "文本太长。请只粘贴 KM 链接。"

#: texts.py
msgid "ESI returned an incomplete killmail. Try again later."
msgstr "ESI 返回的 KM 不完整。请稍后重试。"

#: texts.py
#, python-format
msgid "You may not post to the ping channel %(name)s."
msgstr "你不能在 Ping 频道 %(name)s 中发布内容。"

#: texts.py
#, python-format
msgid "You no longer lead the group %(group)s in FleetOps."
msgstr "你在 FleetOps 中已不再是小组 %(group)s 的组长。"

#: texts.py
#, python-format
msgid "%(name)s is not a ping channel of the group %(group)s."
msgstr "%(name)s 不是小组 %(group)s 的 Ping 频道。"

#: texts.py
#, python-format
msgid "The leaders of %(group)s may only send pings."
msgstr "小组 %(group)s 的组长只能发送 Ping。"

#: texts.py
#, python-format
msgid "Fleet type %(type)s is not allowed for the group %(group)s."
msgstr "小组 %(group)s 不能使用舰队类型 %(type)s。"

#: texts.py
msgid "Choose the group this fleet belongs to."
msgstr "请选择这支舰队所属的小组。"

#: texts.py
msgid "Group fleets cannot be pre pinged. Send the fleet time with Send Ping and start the fleet when it is due."
msgstr "小组舰队不能预 Ping。请用“发送 Ping”发布舰队时间，到点再开舰队。"

#: texts.py
#, python-format
msgid "Group fleets of %(group)s get no SRP link."
msgstr "小组 %(group)s 的舰队不创建 SRP 链接。"

#: texts.py
msgid "This form was already sent. Reload the page to start another fleet."
msgstr "此表单已经提交过。请重新加载页面以开始另一支舰队。"

#: texts.py
msgid "Fleet detection"
msgstr "舰队检测"

#: texts.py
msgid "Fleet cancellation"
msgstr "舰队取消"

#: texts.py
msgid "PAP link fleet"
msgstr "PAP 登记链接舰队"

#: texts.py
msgid "Kick member"
msgstr "踢出成员"

#: texts.py
msgid "Fleet template"
msgstr "舰队模板"

#: texts.py
msgid "Fleet move"
msgstr "舰队移动"

#: texts.py
msgid "Fleet invite"
msgstr "舰队邀请"

#: texts.py
msgctxt "fleet position"
msgid "Fleet Commander"
msgstr "舰队指挥官"

#: texts.py
msgctxt "fleet position"
msgid "Wing Commander"
msgstr "联队指挥官"

#: texts.py
msgctxt "fleet position"
msgid "Squad Commander"
msgstr "中队指挥官"

#: texts.py
msgctxt "fleet position"
msgid "Squad Member"
msgstr "中队队员"

#: texts.py
