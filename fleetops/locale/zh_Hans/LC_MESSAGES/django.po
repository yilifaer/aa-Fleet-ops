#: forms_config.py
msgid "The target applies from the first day of this month (EVE time) until the next entry."
msgstr "达标线从该月第一天（EVE 时间）起生效，直到下一条记录。"

#: forms_config.py
msgid "A target for this month already exists."
msgstr "该月份已经有达标线。"

#: forms_config.py
msgid "Issue a new join link"
msgstr "重新生成加入链接"

#: forms_config.py
msgid "The current join link stops working. Use it when the link was shared where it should not be."
msgstr "当前的加入链接会失效。链接被发到了不该发的地方时使用。"

#: forms_config.py
#, python-format
msgid "The personal user name '%(user)s' and the password were removed from the voice link."
msgstr "语音链接中的个人用户名“%(user)s”和密码已被移除。"

#: forms_config.py
#, python-format
msgid "The personal user name '%(user)s' was removed from the voice link."
msgstr "语音链接中的个人用户名“%(user)s”已被移除。"

#: forms_config.py
msgid "The personal log-in details were removed from the voice link."
msgstr "语音链接中的个人登录信息已被移除。"

#: forms_config.py
msgid "In-game link"
msgstr "游戏内链接"

#: forms_config.py
msgid "Paste the channel link copied in game, or joinChannel:player_…. It replaces the in-game channel ID and fills an empty channel name."
msgstr "粘贴在游戏中复制的频道链接，或 joinChannel:player_…。它会替换游戏内频道 ID，并在频道名称为空时填入名称。"

#: forms_config.py views_config.py
msgid "In-game channel ID"
msgstr "游戏内频道 ID"

#: forms_config.py
msgid "Channel name shown in the MOTD. Left empty, it is taken from the pasted in-game link."
msgstr "MOTD 中显示的频道名称。留空时取自粘贴的游戏内链接。"

#: forms_config.py
msgid "The player_… ID that makes the channel name a link in the MOTD. Clear it to remove the link."
msgstr "让 MOTD 中的频道名称成为链接的 player_… ID。清空即可移除链接。"

#: forms_config.py
msgid "No joinChannel:player_… link found."
msgstr "没有找到 joinChannel:player_… 链接。"

#: forms_config.py
msgid "inactive, not on Discord"
msgstr "未启用，不在 Discord 上"

#: forms_config.py
