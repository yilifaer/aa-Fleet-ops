msgid "Channel name"
msgstr "频道名称"

#: forms_config.py
msgid "Allow @everyone"
msgstr "允许 @everyone"

#: forms_config.py
msgid "Allow @here"
msgstr "允许 @here"

#: forms_config.py models.py views_config.py
msgid "Allowed roles"
msgstr "允许的身份组"

#: forms_config.py
msgid "Shown to FCs when they choose where the ping goes."
msgstr "FC 选择 Ping 发往何处时显示。"

#: forms_config.py models.py
msgid "Leave empty to allow every active role."
msgstr "留空表示允许所有已启用的身份组。"

#: forms_config.py
msgid "Only applies while the channel is assigned to at least one group. FC leads (manage_fleets) can always use it."
msgstr "只有该频道分配给至少一个小组时才生效。FC 主管（manage_fleets）始终可以使用。"

#: forms_config.py
msgid "Leave empty to keep the stored URL."
msgstr "留空表示保留已保存的地址。"

#: forms_config.py
msgid "Alliance FCs can still use this channel. Untick \"Alliance FCs can use this channel\" to reserve it for the groups."
msgstr "联盟 FC 仍然可以使用此频道。取消勾选“联盟 FC 也可以使用此频道”即可把它留给这些小组。"

#: forms_config.py models.py views_config.py
msgid "Role ID"
msgstr "身份组 ID"

#: forms_config.py
msgid "In Discord: Server Settings → Roles → ⋯ → Copy Role ID (needs Developer Mode). A role mention such as <@&123…> works too."
msgstr "在 Discord 中：服务器设置 → 身份组 → ⋯ → 复制身份组 ID（需要开启开发者模式）。也可以粘贴身份组提及，例如 <@&123…>。"

#: forms_config.py
msgid "Enter the numeric Discord role ID."
msgstr "请输入数字形式的 Discord 身份组 ID。"

#: forms_config.py
msgid "Members can only submit claims while FleetOps SRP is enabled. The SRP provider and the automatic link creation at fleet start are set in the general settings."
msgstr "只有启用 FleetOps SRP 时，成员才能提交申请。SRP 提供方和开队时自动创建链接在常规设置中配置。"

#: forms_config.py
msgctxt "SRP loss value"
msgid "Value"
msgstr "价值"

#: forms_config.py
msgid "Where the loss value comes from. It is only used for ships that are not in the payout table."
msgstr "损失价值的来源。只用于不在赔付表中的舰船。"

#: forms_config.py
msgid "Payouts and caps"
msgstr "赔付与上限"

#: forms_config.py
msgid "Ships in the payout table get their fixed amount; every other ship gets the percentage of its value. The per-loss caps apply to both."
msgstr "赔付表中的舰船获得固定金额；其他舰船获得其价值的一定比例。单笔上限对两者都适用。"

#: forms_config.py templates/fleetops/srp/claim.html
msgid "Monthly limits"
msgstr "月度限额"

#: forms_config.py
msgid "Approved SRP per EVE month of the loss. The most restrictive limit wins. Corporations can have their own limit."
msgstr "按损失发生的 EVE 月统计已通过的 SRP。以最严格的限额为准。军团可以有自己的限额。"

#: forms_config.py
msgid "Members and review"
msgstr "成员与审核"

#: forms_config.py
#, python-format
msgid "No ship called “%(name)s” was found. Use its exact English name or its type ID."
msgstr "找不到名为“%(name)s”的舰船。请使用准确的英文名称或船型 ID。"

#: forms_config.py
msgid "ESI could not look up the ship right now. Enter the ship type ID instead."
msgstr "ESI 暂时无法查询该舰船。请改为输入船型 ID。"

#: forms_config.py
msgid "The ship name could not be looked up, so the rule was saved with the ship type ID only."
msgstr "无法查询舰船名称，因此规则只保存了船型 ID。"

#: forms_config.py
msgid "This ID is not an item type."
msgstr "此 ID 不是物品类型。"

#: forms_config.py
msgid "Enter a valid ship type ID."
msgstr "请输入有效的船型 ID。"

#: forms_config.py
msgid "A doctrine rule only applies to losses in a fleet; choose “In fleet and out of fleet” or “In-fleet losses only”."
msgstr "教义规则只适用于舰队内的损失；请选择“舰队内和舰队外”或“仅舰队内损失”。"

#: forms_config.py services/export_datasets.py srp/display.py
#: templates/fleetops/operation/_members.html
#: templates/fleetops/operation/_srp.html templates/fleetops/roster_import.html
#: templates/fleetops/srp/_claims_table.html
#: templates/fleetops/srp/_summary_table.html templates/fleetops/srp/claim.html
#: templates/fleetops/srp/payments.html views_config.py
msgid "Ship"
msgstr "舰船"

#: forms_config.py
msgid "Ship type ID or exact English name. Leave empty for a rule on a doctrine only."
msgstr "船型 ID 或准确的英文名称。仅按教义设置规则时留空。"

#: forms_config.py
msgid "Doctrine rules only apply to losses in a fleet that flew this doctrine."
msgstr "教义规则只适用于使用该教义的舰队内的损失。"

#: forms_config.py
msgid "Custom doctrine name"
msgstr "自定义教义名称"

#: forms_config.py
msgid "For fleets with a typed doctrine name; matched ignoring case. Used with “Custom name”."
msgstr "用于手动填写了教义名称的舰队；匹配时忽略大小写。与“自定义名称”配合使用。"

#: forms_config.py
msgid "Amount (ISK)"
msgstr "金额（ISK）"

#: forms_config.py
msgid "Optional name, shown in the payout table and in a claim's calculation."
msgstr "可选名称，显示在赔付表和申请的计算说明中。"

#: forms_config.py
msgid "Paid as it is, before the per-loss cap and the monthly limits."
msgstr "按此金额计算，之后再应用单笔上限和月度限额。"

#: forms_config.py
msgid "Optional remark for the other SRP managers."
msgstr "可选，给其他 SRP 管理员的备注。"

#: forms_config.py views_config.py
msgid "Any doctrine"
msgstr "任意教义"

#: forms_config.py
msgid "Custom name"
msgstr "自定义名称"

#: forms_config.py
#, python-format
msgid "%(name)s (no longer listed)"
msgstr "%(name)s（已不在列表中）"

#: forms_config.py
msgid "Enter the doctrine name."
msgstr "请输入教义名称。"

#: forms_config.py models.py
msgid "Corporation ID"
msgstr "军团 ID"

#: forms_config.py models.py
msgid "Corporation name"
msgstr "军团名称"

#: forms_config.py
msgid "The corporation ID, for example from its zKillboard page."
msgstr "军团 ID，例如取自它的 zKillboard 页面。"

#: forms_config.py
msgid "Left empty, it is looked up."
msgstr "留空时会自动查询。"

#: forms_config.py
msgid "This corporation already has a limit."
msgstr "该军团已经有限额。"

#: forms_config.py services/export_datasets.py
msgid "Monthly cap (ISK)"
msgstr "月度上限（ISK）"

#: forms_config.py
msgid "Maximum approved SRP of this corporation per EVE month. Empty means no limit for this corporation, whatever the default is."
msgstr "该军团每个 EVE 月可通过的 SRP 上限。留空表示该军团不设限额，无论默认值是多少。"

#: forms_config.py
msgid "Enter a valid corporation ID."
msgstr "请输入有效的军团 ID。"

#: forms_config.py
msgid "The corporation name could not be looked up; the limit was saved with the ID only."
msgstr "无法查询军团名称；限额只保存了军团 ID。"

#: forms_fleet.py
msgid "Enter the numeric ID; name lookup needs django-eveonline-sde."
msgstr "请输入数字 ID；按名称查找需要 django-eveonline-sde。"

#: forms_fleet.py
msgid "The SDE could not be read. Enter the numeric ID."
msgstr "无法读取 SDE。请输入数字 ID。"

#: forms_fleet.py models.py views_config.py
msgid "Fleet positions"
msgstr "舰队位置"

#: forms_fleet.py
msgid "Members in these positions count under this function whatever they fly."
msgstr "处于这些位置的成员，不论驾驶什么舰船，都计入此功能。"

#: forms_fleet.py views_config.py
msgid "Colour"
msgstr "颜色"

#: forms_fleet.py
msgid "Default function"
msgstr "默认功能"

#: forms_fleet.py
msgid "Shown as a small swatch next to the function in the fleet composition."
msgstr "在舰队编成中显示为功能旁边的小色块。"

#: forms_fleet.py
msgid "Lower numbers come first; when two rules match a ship, the lower one wins."
msgstr "数字小的排在前面；两条规则都匹配同一艘舰船时，数字小的生效。"

#: forms_fleet.py
msgid "Inactive functions and their rules are ignored."
msgstr "未启用的功能及其规则会被忽略。"

