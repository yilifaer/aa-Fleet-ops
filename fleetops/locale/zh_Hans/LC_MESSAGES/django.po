#: texts.py
#, python-format
msgid "\"%(role)s\" is not a fleet position."
msgstr "“%(role)s”不是舰队位置。"

#: texts.py
msgid "The fleet commander has no wing or squad."
msgstr "舰队指挥官没有联队或中队。"

#: texts.py
msgid "A wing commander needs a wing."
msgstr "联队指挥官需要指定联队。"

#: texts.py
msgid "A wing commander has no squad."
msgstr "联队指挥官没有中队。"

#: texts.py
msgid "Choose both a wing and a squad, or neither to join any squad with free positions."
msgstr "请同时选择联队和中队；都不选则加入任意有空位的中队。"

#: texts.py
msgid "A squad commander needs a wing and a squad."
msgstr "中队指挥官需要指定联队和中队。"

#: texts.py
msgid "A squad member needs a wing and a squad."
msgstr "中队队员需要指定联队和中队。"

#: texts.py
msgid "That squad is not part of the chosen wing."
msgstr "该中队不属于所选的联队。"

#: texts.py
#, python-format
msgid "The fleet already has a fleet commander (%(holder)s). Move them first."
msgstr "舰队已经有舰队指挥官（%(holder)s）。请先把他移走。"

#: texts.py
#, python-format
msgid "%(unit)s already has a wing commander (%(holder)s). Move them first."
msgstr "%(unit)s 已经有联队指挥官（%(holder)s）。请先把他移走。"

#: texts.py
#, python-format
msgid "%(unit)s already has a squad commander (%(holder)s). Move them first."
msgstr "%(unit)s 已经有中队指挥官（%(holder)s）。请先把他移走。"

#: texts.py
#, python-format
msgid "The fleet is full: EVE allows %(max)s members."
msgstr "舰队已满：EVE 最多允许 %(max)s 名成员。"

#: texts.py
#, python-format
msgid "Only %(count)s more character fits into the fleet (EVE allows %(max)s members)."
msgstr "舰队只能再容纳 %(count)s 个角色（EVE 最多允许 %(max)s 名成员）。"

#: texts.py
#, python-format
msgid "Only %(count)s more characters fit into the fleet (EVE allows %(max)s members)."
msgstr "舰队只能再容纳 %(count)s 个角色（EVE 最多允许 %(max)s 名成员）。"

#: texts.py
#, python-format
msgid "EVE allows at most %(max)s wings."
msgstr "EVE 最多允许 %(max)s 个联队。"

#: texts.py
#, python-format
msgid "EVE allows at most %(max)s squads per wing."
msgstr "EVE 每个联队最多允许 %(max)s 个中队。"

#: texts.py
msgid "Only empty wings can be deleted: move the wing commander and all squad members first."
msgstr "只能删除空联队：请先移走联队指挥官和所有中队队员。"

#: texts.py
msgid "Only empty squads can be deleted. Move its member first."
msgstr "只能删除空中队。请先移走它的成员。"

#: texts.py
#, python-format
msgid "Only empty squads can be deleted. Move its %(count)s members first."
msgstr "只能删除空中队。请先移走它的 %(count)s 名成员。"

#: texts.py
#, python-format
msgid "\"%(role)s\" is not a commander position. Use fleet_commander, wing_commander or squad_commander."
msgstr "“%(role)s”不是指挥官位置。请使用 fleet_commander、wing_commander 或 squad_commander。"

#: texts.py
msgid "Not one of your characters."
msgstr "不是你的角色。"

#: texts.py
msgid "No valid ESI token with the PAP link scopes; use Add a character to log in with it."
msgstr "没有带 PAP 登记链接所需权限范围的有效 ESI 令牌；请用“添加角色”来登录它。"

#: texts.py
msgid "The ESI token could not be checked; try again."
msgstr "无法检查 ESI 令牌；请重试。"

#: texts.py
msgid "Already registered for this fleet."
msgstr "已经为这支舰队登记过了。"

#: texts.py
msgid "The PAP link is no longer open."
msgstr "此 PAP 登记链接已不再开放。"

#: texts.py
msgid "PAP links are not available for fleets closed before PAP followed time in fleet; add manual PAP instead."
msgstr "在 PAP 按在队时长发放之前就已结束的舰队不能使用 PAP 登记链接；请改为补录 PAP。"

#: texts.py
msgid "Not logged in to the game; this PAP link needs the character online."
msgstr "没有登录游戏；此 PAP 登记链接要求角色在线。"

#: texts.py
#, python-format
msgid "At most %(limit)s characters are registered at once; register this one again."
msgstr "一次最多登记 %(limit)s 个角色；请再单独登记这个角色。"

#: texts.py
#, python-format
msgid "PAP links are created for active or closed fleets; this fleet is %(status)s."
msgstr "PAP 登记链接只能为进行中或已结束的舰队创建；这支舰队的状态是 %(status)s。"

#: texts.py
#, python-format
msgid "A PAP link stays open for %(min)s to %(max)s minutes."
msgstr "PAP 登记链接的开放时长为 %(min)s 到 %(max)s 分钟。"

#: texts.py
msgid "Manual PAP is entered by hand or imported from a roster."
msgstr "补录 PAP 由手工录入或从名单导入。"

#: texts.py
msgid "Choose whether to keep, replace or merge the tracked PAP."
msgstr "请选择保留、替换还是合并追踪得到的 PAP。"

#: texts.py
#, python-format
msgid "The PAP multiplier must be a whole number from 1 to %(max)s."
msgstr "PAP 倍率必须是 1 到 %(max)s 之间的整数。"

#: texts.py views.py views_records.py
msgid "Manual PAP can only be added to Active or Closed fleets."
msgstr "只能给进行中或已结束的舰队补录 PAP。"

#: texts.py
msgid "This fleet is already approved."
msgstr "这支舰队已经通过审批。"

#: texts.py
msgid "Only fleets waiting for approval can be rejected."
msgstr "只能拒绝等待审批的舰队。"

#: texts.py
msgid "Give a reason for excluding this fleet from the statistics."
msgstr "请填写把这支舰队排除出统计的原因。"

#: texts.py
msgid "Choose whether this fleet counts automatically, always or never."
msgstr "请选择这支舰队是自动计入、始终计入还是不计入。"

#: texts.py
msgid "FC incentives are disabled in the FleetOps settings."
msgstr "FC 奖金已在 FleetOps 设置中停用。"

#: texts.py
msgid "Finalized periods must be unlocked before waiver changes."
msgstr "已定稿的周期需要先解锁，才能修改放弃领取状态。"

#: texts.py
msgid "Finalized periods must be unlocked before recalculation."
msgstr "已定稿的周期需要先解锁，才能重新计算。"

#: texts.py
msgid "Period must be in review before finalizing."
msgstr "周期必须处于审核状态才能定稿。"

#: texts.py
msgid "Only finalized periods can be unlocked."
msgstr "只有已定稿的周期才能解锁。"

#: texts.py
msgid "FC statistic does not exist. Recalculate the period first."
msgstr "FC 统计不存在。请先重新计算该周期。"

#: texts.py
msgid "Unknown special role."
msgstr "未知的特殊角色。"

#: texts.py
#, python-format
msgid "The special role %(name)s is disabled."
msgstr "特殊角色 %(name)s 已停用。"

#: texts.py
msgid "Special roles are given to characters recorded in the fleet."
msgstr "特殊角色只能指派给舰队中有记录的角色。"

#: texts.py
msgid "A preset needs a name."
msgstr "预设需要一个名称。"

#: texts.py
msgid "The preview is older than 30 minutes or was changed. Paste the roster again."
msgstr "预览已超过 30 分钟，或已被修改。请重新粘贴名单。"

#: texts.py
msgid "No EVE character with this name"
msgstr "没有这个名称的 EVE 角色"

#: texts.py
msgid "Could not be checked (ESI error)"
msgstr "无法检查（ESI 错误）"

#: texts.py
msgid "Already has PAP in this fleet"
msgstr "在这支舰队中已有 PAP"

#: texts.py
msgid "Listed twice"
msgstr "重复出现"

#: texts.py
msgid "draft"
msgstr "草稿"

#: texts.py
msgid "scheduled"
msgstr "已预约"

#: texts.py
msgid "starting"
msgstr "开队中"

#: texts.py
msgid "ending"
msgstr "结束中"

#: texts.py
msgid "cancelled"
msgstr "已取消"

