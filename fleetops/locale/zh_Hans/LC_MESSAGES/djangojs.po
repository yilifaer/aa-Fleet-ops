#: static/fleetops/structure_layout.js
msgid "Line %(line)s: a wing name is empty."
msgstr "第 %(line)s 行：联队名称为空。"

#: static/fleetops/structure_layout.js
msgid "Line %(line)s: a squad name is empty."
msgstr "第 %(line)s 行：中队名称为空。"

#: static/fleetops/structure_layout.js
msgid "Line %(line)s: wing name \"%(name)s\" is longer than %(max)s characters."
msgstr "第 %(line)s 行：联队名称“%(name)s”超过 %(max)s 个字符。"

#: static/fleetops/structure_layout.js
msgid "Line %(line)s: squad name \"%(name)s\" is longer than %(max)s characters."
msgstr "第 %(line)s 行：中队名称“%(name)s”超过 %(max)s 个字符。"

