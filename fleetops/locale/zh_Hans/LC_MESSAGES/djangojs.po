msgid "Line %(line)s: EVE allows at most %(max)s wings."
msgstr "第 %(line)s 行：EVE 最多允许 %(max)s 个联队。"

#: static/fleetops/structure_layout.js
msgid "Line %(line)s: wing \"%(wing)s\" needs at least one squad, for example \"%(wing)s: Squad 1\"."
msgstr "第 %(line)s 行：联队“%(wing)s”至少需要一个中队，例如“%(wing)s: 中队 1”。"

#: static/fleetops/structure_layout.js
msgid "Line %(line)s: use one \":\" per line, between the wing name and its squads."
msgstr "第 %(line)s 行：每行使用一个“:”，放在联队名称和它的中队之间。"

#: static/fleetops/structure_layout.js
msgid "Line %(line)s: wing \"%(wing)s\" has %(count)s squads; EVE allows at most %(max)s per wing."
msgstr "第 %(line)s 行：联队“%(wing)s”有 %(count)s 个中队；EVE 每个联队最多允许 %(max)s 个。"

#: static/fleetops/structure_layout.js
msgid "Add at least one wing, for example \"Main: Alpha, Bravo\"."
msgstr "请至少添加一个联队，例如“Main: Alpha, Bravo”。"

#: static/fleetops/structure_layout.js
msgid "%(wings)s with %(squads)s: %(layout)s"
